// Prisma schema — dating app
// Run: npx prisma db push   (or)   npx prisma migrate dev

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ──────────────────────────────────────────────────────────────────────
// NextAuth tables (PrismaAdapter compatible)
// ──────────────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ──────────────────────────────────────────────────────────────────────
// Domain models
// ──────────────────────────────────────────────────────────────────────

enum Gender {
  man
  woman
  nonbinary
  other
}

enum Orientation {
  straight
  gay
  lesbian
  bisexual
  pansexual
  asexual
  other
}

enum AccessTier {
  free
  plus
  insights
}

enum HookTarget {
  photo
  prompt
  profile
}

// ──────────────────────────────────────────────────────────────────────
// Email domains.
//
// One row per distinct sign-in domain. We never derive an institution name
// from a domain — `name` stays null until a human fills it in, and the UI
// shows the raw domain until then.
//
// `poolId` is what random pairing shards on. It defaults to the row's own
// id, so every domain is its own pool; pointing several rows at one id
// merges them into a single pool. That is an admin action, never a guess.
// ──────────────────────────────────────────────────────────────────────

model Domain {
  id        String   @id @default(cuid())
  domain    String   @unique
  name      String?
  poolId    String
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  users     User[]

  @@index([poolId])
}

enum RandomQueueState {
  waiting
  paired
}

enum RandomEndReason {
  left
  skipped
  reported
  expired
}

model User {
  id              String        @id @default(cuid())
  // Supabase auth.users.id (UUID) for the OAuth identity linked to this profile.
  authId          String?       @unique @db.Uuid
  email           String        @unique
  // The sign-in domain this member belongs to. Nullable because a legacy
  // row predates the Domain migration.
  domainId        String?
  emailDomain     Domain?       @relation(fields: [domainId], references: [id], onDelete: SetNull)
  emailVerified   DateTime?
  // Real name from the OAuth identity. NEVER sent to the other side of an
  // anonymous chat — only after a mutual reveal.
  name            String?
  // Self-chosen handle shown in random chat. Null = fall back to a
  // generated per-session alias. Not unique, on purpose.
  displayName     String?
  // Soft pairing signal for random chat. Never used as a filter.
  interests       String[]      @default([])
  // Stated random-chat preferences. Stored, but pair_random() does not
  // read them yet — see prisma-migrations/2026-09-05-random-preferences.sql
  randomPrefGender    String    @default("anyone")
  randomPrefWorkspace String    @default("same")
  age             Int?
  // Free-form fields that the UI may use but that must NOT be exposed as
  // identity-revealing in the public profile UI. We keep them generic.
  year            Int?
  department      String?
  bio             String?       @db.Text
  gender          Gender?
  orientation     Orientation?
  showMe          Gender[]      @default([])
  // Free-form profile fields surfaced on the discover card
  height          String?
  location        String?
  intentions      String?
  relationshipType String?
  // Discovery filter preferences (set from the filter chips)
  filterAgeMin    Int           @default(18)
  filterAgeMax    Int           @default(99)
  accessTier      AccessTier    @default(free)
  verified        Boolean       @default(false)
  foundingMember  Boolean       @default(false)
  paused          Boolean       @default(false)
  qrCode          String?       @unique
  invitedById     String?
  invitedBy       User?         @relation("Invites", fields: [invitedById], references: [id])
  invites         User[]        @relation("Invites")
  isAdmin         Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  lastSeenAt      DateTime?

  photos          Photo[]
  userPrompts     UserPrompt[]
  hooksSent       Hook[]        @relation("HookFrom")
  hooksReceived   Hook[]        @relation("HookTo")
  matchesA        Match[]       @relation("MatchA")
  matchesB        Match[]       @relation("MatchB")
  messages        Message[]     @relation("MsgFrom")
  reportsFiled    Report[]      @relation("Reporter")
  reportsOn       Report[]      @relation("ReportedUser")
  payments        Payment[]
  blocksMade      Block[]       @relation("BlockFrom")
  blocksReceived  Block[]       @relation("BlockTo")
  accounts        Account[]
  sessions        Session[]
  conversationsA  Conversation[] @relation("ConvA")
  conversationsB  Conversation[] @relation("ConvB")
  rosesSent       Rose[]        @relation("RoseFrom")
  rosesReceived   Rose[]        @relation("RoseTo")
  confessionReactions ConfessionReaction[]
  confessionReplies   ConfessionReply[]
  referralsMade   Referral[]    @relation("ReferralInviter")
  referralsGot    Referral[]    @relation("ReferralInvitee")
  pushSubscriptions PushSubscription[]
  randomQueue     RandomQueue?
  randomSessionsA RandomSession[] @relation("RandomA")
  randomSessionsB RandomSession[] @relation("RandomB")
  randomMessages  RandomMessage[]
  randomPing      RandomPing?

  @@index([gender, orientation, paused])
  @@index([domainId])
}

model Photo {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url         String
  publicId    String   // Cloudinary public_id, for deletion
  width       Int?
  height      Int?
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([userId, position])
}

model Prompt {
  id        String       @id @default(cuid())
  // The serif question shown on profile cards.
  text      String       @unique
  category  String?
  active    Boolean      @default(true)
  userPrompts UserPrompt[]
  hooks     Hook[]
}

model UserPrompt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  promptId  String
  prompt    Prompt   @relation(fields: [promptId], references: [id])
  answer    String   @db.Text
  position  Int      @default(0)
  createdAt DateTime @default(now())

  hooks     Hook[]

  @@unique([userId, promptId])
  @@index([userId])
}

model Hook {
  id          String     @id @default(cuid())
  fromUserId  String
  fromUser    User       @relation("HookFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId    String
  toUser      User       @relation("HookTo", fields: [toUserId], references: [id], onDelete: Cascade)
  targetType  HookTarget
  // For photo / userPrompt targets, store the foreign id loosely so we can
  // resolve at read time. For profile target this is null.
  photoId     String?
  userPromptId String?
  promptId    String?
  prompt      Prompt?    @relation(fields: [promptId], references: [id])
  userPrompt  UserPrompt? @relation(fields: [userPromptId], references: [id])
  note        String?    @db.Text
  isHardHook  Boolean    @default(false)
  seen        Boolean    @default(false)
  createdAt   DateTime   @default(now())

  @@unique([fromUserId, toUserId])
  @@index([toUserId, seen])
}

model Match {
  id           String        @id @default(cuid())
  userAId      String
  userA        User          @relation("MatchA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId      String
  userB        User          @relation("MatchB", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  conversation Conversation?

  @@unique([userAId, userBId])
}

model Conversation {
  id                 String    @id @default(cuid())
  // Nullable now — a Conversation is created the moment one user hooks
  // another (one-way), and gets linked to a Match later if mutual.
  matchId            String?   @unique
  match              Match?    @relation(fields: [matchId], references: [id], onDelete: SetNull)
  userAId            String
  userA              User      @relation("ConvA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId            String
  userB              User      @relation("ConvB", fields: [userBId], references: [id], onDelete: Cascade)
  interactionSeconds Int       @default(0)
  // Per-user activity timestamps for the rolling active window check.
  lastActiveA        DateTime?
  lastActiveB        DateTime?
  // Cached cap so a tier change after the fact doesn't surprise users mid-chat.
  capSeconds         Int       @default(900)
  locked             Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  messages           Message[]

  @@index([userAId, userBId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  fromUserId     String
  fromUser       User         @relation("MsgFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  body           String?      @db.Text
  messageType    String       @default("text")
  photoUrl       String?
  photoPublicId  String?
  viewsRemaining Int?
  createdAt      DateTime     @default(now())
  reports        Report[]

  @@index([conversationId, createdAt])
}

model Confession {
  id          String                @id @default(cuid())
  // Scoped to the author's pairing pool, same rule as random chat.
  poolId      String?
  // Identity hidden from users, visible to admins via this column.
  authorId    String
  body        String                @db.Text
  approved    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  reactions   ConfessionReaction[]
  replies     ConfessionReply[]
  reports     Report[]

  @@index([approved, createdAt])
  @@index([poolId, approved, createdAt])
}

model ConfessionReaction {
  id           String     @id @default(cuid())
  confessionId String
  confession   Confession @relation(fields: [confessionId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         String     // "fire" | "real" | "samesame" — anonymous, simple
  createdAt    DateTime   @default(now())

  @@unique([confessionId, userId, kind])
}

model ConfessionReply {
  id           String     @id @default(cuid())
  confessionId String
  confession   Confession @relation(fields: [confessionId], references: [id], onDelete: Cascade)
  authorId     String
  author       User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body         String     @db.Text
  approved     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  reports      Report[]

  @@index([confessionId, createdAt])
}

enum ReportTargetType {
  user
  message
  confession
  confession_reply
  photo
  random_message
}

enum ReportStatus {
  open
  reviewed
  actioned
  dismissed
}

model Report {
  id                  String           @id @default(cuid())
  reporterId          String
  reporter            User             @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType          ReportTargetType
  targetUserId        String?
  targetUser          User?            @relation("ReportedUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  targetMessageId     String?
  targetMessage       Message?         @relation(fields: [targetMessageId], references: [id], onDelete: SetNull)
  targetConfessionId  String?
  targetConfession    Confession?      @relation(fields: [targetConfessionId], references: [id], onDelete: SetNull)
  targetReplyId       String?
  targetReply         ConfessionReply? @relation(fields: [targetReplyId], references: [id], onDelete: SetNull)
  // Random-chat messages live in their own table, so they need their own
  // pointer — targetMessageId is bound to "Message".
  targetRandomMessageId String?
  targetRandomMessage   RandomMessage? @relation(fields: [targetRandomMessageId], references: [id], onDelete: SetNull)
  reason              String           @db.Text
  status              ReportStatus     @default(open)
  createdAt           DateTime         @default(now())

  @@index([status, createdAt])
  @@index([targetRandomMessageId])
}

model Block {
  id         String   @id @default(cuid())
  fromUserId String
  fromUser   User     @relation("BlockFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User     @relation("BlockTo", fields: [toUserId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([fromUserId, toUserId])
}

model Pass {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String
  createdAt  DateTime @default(now())

  @@unique([fromUserId, toUserId])
  @@index([fromUserId, createdAt(sort: Desc)])
}

model Impression {
  id          String   @id @default(cuid())
  viewerId    String
  candidateId String
  lastShownAt DateTime @default(now())

  @@unique([viewerId, candidateId])
  @@index([viewerId, lastShownAt(sort: Desc)])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

enum PaymentKind {
  plus
  insights
  chat_extension
}

enum PaymentStatus {
  created
  captured
  failed
  refunded
}

model Payment {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind            PaymentKind
  amountPaise     Int
  currency        String        @default("INR")
  status          PaymentStatus @default(created)
  razorpayOrderId String        @unique
  razorpayPaymentId String?     @unique
  razorpaySignature String?
  // For chat_extension: which conversation got extended (optional).
  conversationId  String?
  // Tier expiry copy (denormalized so we don't recompute on every read).
  tierUntil       DateTime?
  createdAt       DateTime      @default(now())
  capturedAt      DateTime?

  @@index([userId, status])
}

// Backend-driven configuration (no redeploy to change limits / prices).
model Config {
  key   String @id
  value String @db.Text
  // We store everything as text so admins can edit in Prisma Studio without
  // hitting type errors. Casting happens in lib/config.ts.
  updatedAt DateTime @updatedAt
}

model Rose {
  id         String   @id @default(cuid())
  fromUserId String
  fromUser   User     @relation("RoseFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User     @relation("RoseTo", fields: [toUserId], references: [id], onDelete: Cascade)
  note       String?  @db.Text
  weekOf     DateTime // truncate to ISO week to enforce 1/week
  createdAt  DateTime @default(now())

  @@unique([fromUserId, weekOf])
  @@index([toUserId])
}

model Referral {
  id          String   @id @default(cuid())
  inviterId   String
  inviter     User     @relation("ReferralInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  inviteeId   String?
  invitee     User?    @relation("ReferralInvitee", fields: [inviteeId], references: [id], onDelete: SetNull)
  code        String   @unique
  email       String?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([inviterId, verified])
}


// ──────────────────────────────────────────────────────────────────────
// Random chat — the primary feature.
//
// A member enters the queue; the matchmaker pairs them with another
// waiting member from the SAME college and opens a RandomSession. The
// pairing itself happens inside a Postgres function so two concurrent
// requests can never claim the same partner (see prisma-migrations/).
// ──────────────────────────────────────────────────────────────────────

model RandomQueue {
  // One row per user — entering the queue twice just refreshes the row.
  userId      String           @id
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Pairing pool = Domain.poolId. Denormalised onto the queue row so the
  // matchmaker never joins to resolve it.
  poolId      String
  state       RandomQueueState @default(waiting)
  // Set the moment the matchmaker pairs this row; the client polls for it.
  sessionId   String?
  joinedAt    DateTime         @default(now())
  // Refreshed by the waiting client every few seconds. A row that stops
  // beating is swept so we never pair against a closed tab.
  heartbeatAt DateTime         @default(now())

  @@index([poolId, state, heartbeatAt])
  @@index([state, heartbeatAt])
}

model RandomSession {
  id         String           @id @default(cuid())
  poolId     String
  userAId    String
  userA      User             @relation("RandomA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId    String
  userB      User             @relation("RandomB", fields: [userBId], references: [id], onDelete: Cascade)
  startedAt  DateTime         @default(now())
  endedAt    DateTime?
  endedById  String?
  endReason  RandomEndReason?
  // "Keep this chat" is per-side. A session either side kept is retained
  // indefinitely and shows in that member's chat list; one neither side
  // kept is purged by the retention sweep after RETENTION_DAYS.
  keptByA    Boolean          @default(false)
  keptByB    Boolean          @default(false)
  // Identities stay hidden until BOTH sides ask to reveal. When they do,
  // a real Match + Conversation is created and this points at it — the
  // bridge from random chat into the dating half of the app.
  revealAskedByA Boolean      @default(false)
  revealAskedByB Boolean      @default(false)
  conversationId String?      @unique
  messageCount   Int          @default(0)

  messages   RandomMessage[]

  @@index([userAId, startedAt(sort: Desc)])
  @@index([userBId, startedAt(sort: Desc)])
  @@index([endedAt])
}

model RandomMessage {
  id         String        @id @default(cuid())
  sessionId  String
  session    RandomSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  fromUserId String
  fromUser   User          @relation(fields: [fromUserId], references: [id], onDelete: Cascade)
  body       String        @db.Text
  createdAt  DateTime      @default(now())
  reports    Report[]

  @@index([sessionId, createdAt])
}

// Someone who found an empty queue and asked to be told when the pool wakes
// up. Consumed (deleted) when the push goes out.
model RandomPing {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  poolId    String
  createdAt DateTime @default(now())

  @@index([poolId])
}
