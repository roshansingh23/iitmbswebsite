# ──────────────────────────────────────────────────────────────────────────
# Public site URL
# ──────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ──────────────────────────────────────────────────────────────────────────
# Supabase (Postgres + Realtime)
# Project ref: xwrbyfikhcyxlehffcjm
# Region:      ap-southeast-1
# ──────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xwrbyfikhcyxlehffcjm.supabase.co
# Anon key (already in your project — copy from Supabase dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Postgres connection strings.
# Get the DB password from: Supabase dashboard → Settings → Database → Connection string
# (you set it when the project was created; if lost, reset it there)
#
# DATABASE_URL = pooled (port 6543), used at runtime.
# DIRECT_URL   = direct (port 5432), used by Prisma for migrations.
DATABASE_URL=postgresql://postgres.xwrbyfikhcyxlehffcjm:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.xwrbyfikhcyxlehffcjm:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# ──────────────────────────────────────────────────────────────────────────
# NextAuth
# ──────────────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
# openssl rand -base64 32
NEXTAUTH_SECRET=

# Silent email-domain gate (comma-separated, no spaces).
# Applies to both Google and Email sign-ins. Empty = allow all (dev only).
ALLOWED_EMAIL_DOMAINS=

# ──────────────────────────────────────────────────────────────────────────
# Google OAuth
# Set up at: https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: ${NEXTAUTH_URL}/api/auth/callback/google
# ──────────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ──────────────────────────────────────────────────────────────────────────
# Email transport (optional — only needed for magic-link sign-ins)
# ──────────────────────────────────────────────────────────────────────────
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM="Hooked. <noreply@example.com>"

# ──────────────────────────────────────────────────────────────────────────
# Cloudinary
# ──────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=hooked

# ──────────────────────────────────────────────────────────────────────────
# Admin
# ──────────────────────────────────────────────────────────────────────────
# Comma-separated emails that get access to /admin.
ADMIN_EMAILS=
