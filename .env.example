# ──────────────────────────────────────────────────────────────────────────
# Public site URL
# ──────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ──────────────────────────────────────────────────────────────────────────
# Auth.js (NextAuth) — the OAuth handshake now runs on OUR domain, not on
# supabase.co. Supabase Auth is no longer used; Supabase is data-only.
#
# Google Cloud Console → Credentials → your OAuth client → add this exact
# Authorized redirect URI:
#     https://YOUR-CUSTOM-DOMAIN/api/auth/callback/google
# (also add http://localhost:3000/api/auth/callback/google for local dev)
# ──────────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random 32+ byte secret. Generate: openssl rand -base64 32
NEXTAUTH_SECRET=
# MUST be your live origin in production (custom domain), e.g. https://mismatched.app
NEXTAUTH_URL=http://localhost:3000

# ──────────────────────────────────────────────────────────────────────────
# Supabase — runs Auth, Postgres, and Realtime in one project
# Region:      ap-southeast-1
# ──────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role JWT. Server-side only — NEVER expose to the browser.
# Used for DB writes/reads via PostgREST so we don't need a Postgres password.
# Get it from: Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection strings (Supabase dashboard → Settings → Database).
# Simplest: use the direct connection for both. Works without pooler config.
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# Alternative (pooler-based, better for high concurrency). Make sure the
# cluster hostname matches what the Supabase dashboard shows — this project
# is on aws-1, not aws-0.
# DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# DIRECT_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres

# ──────────────────────────────────────────────────────────────────────────
# Who can sign up. Precedence order:
#   1. ALLOWED_EMAIL_DOMAINS set  -> only those domains (closed campus pilot)
#   2. ACADEMIC_ONLY=true         -> only .edu / .ac.in / .ac.uk / ...
#   3. neither                    -> ANY email address (the default)
#
# Either way, members are grouped by the BASE domain of their address, so
# every subdomain an institution hands out lands in one pool
# (ds.study.x.ac.in and smail.x.ac.in are both x.ac.in). Nothing guesses an
# institution NAME — set Domain.name by hand. Random pairing never crosses
# a poolId boundary.
# ──────────────────────────────────────────────────────────────────────────
ALLOWED_EMAIL_DOMAINS=
ACADEMIC_ONLY=

# ──────────────────────────────────────────────────────────────────────────
# Google OAuth is configured ENTIRELY inside Supabase
# Supabase Dashboard → Authentication → Providers → Google → Enable → paste
# Client ID + Client Secret. Supabase exposes the redirect URL to add to
# Google Cloud Console (looks like https://YOUR-PROJECT-REF.supabase.co/auth/v1/callback).
# No GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET env vars needed here.
# ──────────────────────────────────────────────────────────────────────────

# ──────────────────────────────────────────────────────────────────────────
# Cloudinary
# ──────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=hooked

# ──────────────────────────────────────────────────────────────────────────
# Demo login (temporary). Set a password here and the login screen shows a
# "Use demo login" option that signs in as DEMO_LOGIN_EMAIL without Google.
# Unset it to remove the demo door entirely — the provider is not even
# registered when this is blank. The demo profile row is created paused, so
# it never appears in real members' discover feed.
# ──────────────────────────────────────────────────────────────────────────
DEMO_LOGIN_PASSWORD=
DEMO_LOGIN_EMAIL=demo@example.edu

# ──────────────────────────────────────────────────────────────────────────
# Moderation. Comma-separated terms that are blocked outright in random
# chat, on top of the built-in severe patterns. Matched against a
# leet-decoded, separator-stripped form of the message, so "b a d w 0 r d"
# does not slip past. Keep community-specific word lists here rather than in
# lib/text-filter.ts so deploys and word lists stay separate.
# ──────────────────────────────────────────────────────────────────────────
MODERATION_BLOCKLIST=
