# ──────────────────────────────────────────────────────────────────────────
# Public site URL
# ──────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ──────────────────────────────────────────────────────────────────────────
# Auth.js (NextAuth) — the OAuth handshake now runs on OUR domain, not on
# supabase.co. Supabase Auth is no longer used; Supabase is data-only.
#
# Google Cloud Console → Credentials → your OAuth client → add this exact
# Authorized redirect URI:
#     https://YOUR-CUSTOM-DOMAIN/api/auth/callback/google
# (also add http://localhost:3000/api/auth/callback/google for local dev)
# ──────────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random 32+ byte secret. Generate: openssl rand -base64 32
NEXTAUTH_SECRET=
# MUST be your live origin in production (custom domain), e.g. https://mismatched.app
NEXTAUTH_URL=http://localhost:3000

# ──────────────────────────────────────────────────────────────────────────
# Supabase — runs Auth, Postgres, and Realtime in one project
# Project ref: xwrbyfikhcyxlehffcjm
# Region:      ap-southeast-1
# ──────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xwrbyfikhcyxlehffcjm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role JWT. Server-side only — NEVER expose to the browser.
# Used for DB writes/reads via PostgREST so we don't need a Postgres password.
# Get it from: Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection strings (Supabase dashboard → Settings → Database).
# Simplest: use the direct connection for both. Works without pooler config.
DATABASE_URL=postgresql://postgres:PASSWORD@db.xwrbyfikhcyxlehffcjm.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:PASSWORD@db.xwrbyfikhcyxlehffcjm.supabase.co:5432/postgres

# Alternative (pooler-based, better for high concurrency). Make sure the
# cluster hostname matches what the Supabase dashboard shows — this project
# is on aws-1, not aws-0.
# DATABASE_URL=postgresql://postgres.xwrbyfikhcyxlehffcjm:PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# DIRECT_URL=postgresql://postgres.xwrbyfikhcyxlehffcjm:PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres

# Optional: silent domain allowlist (comma-separated). Empty = allow all.
ALLOWED_EMAIL_DOMAINS=

# ──────────────────────────────────────────────────────────────────────────
# Google OAuth is configured ENTIRELY inside Supabase
# Supabase Dashboard → Authentication → Providers → Google → Enable → paste
# Client ID + Client Secret. Supabase exposes the redirect URL to add to
# Google Cloud Console (looks like https://xwrbyfikhcyxlehffcjm.supabase.co/auth/v1/callback).
# No GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET env vars needed here.
# ──────────────────────────────────────────────────────────────────────────

# ──────────────────────────────────────────────────────────────────────────
# Cloudinary
# ──────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=hooked
