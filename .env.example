# ──────────────────────────────────────────────────────────────────────────
# Required for production. Keep all values out of source control.
# ──────────────────────────────────────────────────────────────────────────

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database (Supabase Postgres or any Postgres) ─────────────────────────
# Use the "Connection pooling" string for runtime (pgbouncer / port 6543).
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1
# Use the direct connection for migrations (port 5432).
DIRECT_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres

# ── NextAuth ──────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
# openssl rand -base64 32
NEXTAUTH_SECRET=

# ── Silent email-domain gate (comma-separated, no spaces) ─────────────────
# Only emails on these domains can complete sign-in. Surface as generic
# error to anyone else. Leave empty to allow all emails (dev only).
ALLOWED_EMAIL_DOMAINS=

# ── Email transport for magic links (SMTP) ────────────────────────────────
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM="dating-app <noreply@example.com>"

# ── Cloudinary ────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=dating-app

# ── Supabase Realtime (chat) ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Razorpay (INR payments) ───────────────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Admin ─────────────────────────────────────────────────────────────────
# Comma-separated list of emails that get access to /admin.
ADMIN_EMAILS=
